{
  "name": "ticket-booking-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "migrate": "dbmate --wait --migration-lock --no-dump-schema up",
    "import": "bun db/importTickets.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test --preload ./test/integration/setup.ts test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "^1.4.3",
    "dbmate": "2.37.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2"
  }
}
